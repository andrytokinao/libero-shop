# JVM options baked into every installer, all operating systems.
#
# ${user.home} is resolved by Spring at RUN TIME on the target machine, not by
# Maven at build time: this file is read directly by jpackage and never
# filtered, and jpackage leaves ${...} untouched (verified). Putting the
# writable state under the user's home lets the app run even when installed in
# a read-only location (Program Files, /Applications, /opt).
#
# Paths may be redirected from outside the jar: LicensePropertyGuard pins only
# the license *switches*, never paths.
--java-options
-Dfile.encoding=UTF-8
--java-options
-Dspring.datasource.url=jdbc:h2:file:${user.home}/.libertyshop/data/libertyshop
--java-options
-Dliberoshop.license.path=${user.home}/.libertyshop/license/libero-shop.lic
--java-options
-Dliberoshop.mobile.downloads-dir=${user.home}/.libertyshop/downloads
# The APK staged beside the jar by the "installer" Maven profile, so that the
# download page works on a fresh installation. $APPDIR is replaced by the
# launcher, at run time, with the folder the jar is installed in.
--java-options
-Dliberoshop.mobile.bundled-apk=$APPDIR/libero-shop.apk
# The key signing the sessions, generated at the first start. Kept apart from
# data/, which a restored backup replaces: a restore must not sign everyone out.
--java-options
-Dliberoshop.security.jwt.secret-file=${user.home}/.libertyshop/security/jwt-secret.key
# The one-time code of the "lost administrator password" procedure: written
# there for whoever sits at this computer to read, deleted once used.
--java-options
-Dliberoshop.security.recovery.code-file=${user.home}/.libertyshop/security/recovery-code.txt
# The password of the administrator account a new installation opens by itself:
# shown on the login page of this computer until it has been replaced.
--java-options
-Dliberoshop.security.first-password-file=${user.home}/.libertyshop/security/first-password.txt
# The installed application has no window: show its state and its menu (open,
# stop, restart, update, quit) in the notification area. See desktop.ServerTray.
--java-options
-Dliberoshop.tray.enabled=true

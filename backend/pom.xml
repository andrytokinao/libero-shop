<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.houssen</groupId>
    <artifactId>liberoshop</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>backend</name>
    <description>backend</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!-- Explicit, so accented French text in sources and license payloads is read
             identically on every build machine rather than through the platform default. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Front end packaged into the jar: ../ui is built and copied to
             src/main/resources/static (git-ignored). -DskipFrontend skips all of it and
             keeps whatever the last build left there. -->
        <frontend.dir>${project.basedir}/../ui</frontend.dir>
        <frontend.static.dir>${project.basedir}/src/main/resources/static</frontend.static.dir>
        <!-- The same app built for the phones, which download it from the server to update
             themselves without a new APK (MobileBundle). Git-ignored, like static/. -->
        <frontend.mobile.dir>${project.basedir}/src/main/resources/mobile-web</frontend.mobile.dir>
        <skipFrontend>false</skipFrontend>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Brings Nimbus JOSE: the JWT encoder, decoder and bearer-token filter. No
             third-party JWT library is needed, and the validation rules are the ones
             Spring Security maintains rather than ones written here. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- STOMP over WebSocket, for the notifications pushed to the screens. The in-memory
             broker it brings is enough for one instance; several instances would relay to an
             external broker instead, with no change to the code that sends. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Reads .xlsx/.xls product imports and writes the downloadable model file. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Obfuscates our own classes (names only) in the thin jar, in the package
                 phase, BEFORE spring-boot:repackage wraps them into the executable jar.
                 Declared first so it runs before repackage within the same phase. The rules
                 live in proguard.conf; dependencies are read as -libraryjars, never touched. -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.7.0</version>
                <executions>
                    <execution>
                        <id>obfuscate</id>
                        <phase>package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <proguardVersion>7.6.1</proguardVersion>
                    <!-- Read the thin jar jar:jar just produced and overwrite it in place. -->
                    <injar>${project.build.finalName}.jar</injar>
                    <outjar>${project.build.finalName}.jar</outjar>
                    <obfuscate>true</obfuscate>
                    <!-- Already the project's main artifact; do not attach a second one. -->
                    <attach>false</attach>
                    <proguardInclude>${project.basedir}/proguard.conf</proguardInclude>
                    <!-- The Java 21 runtime modules: ProGuard needs them to resolve the class
                         hierarchy of everything we keep. ${java.home} is the JDK running Maven. -->
                    <libs>
                        <lib>${java.home}/jmods/java.base.jmod</lib>
                        <lib>${java.home}/jmods/java.sql.jmod</lib>
                        <lib>${java.home}/jmods/java.sql.rowset.jmod</lib>
                        <lib>${java.home}/jmods/java.xml.jmod</lib>
                        <lib>${java.home}/jmods/java.naming.jmod</lib>
                        <lib>${java.home}/jmods/java.management.jmod</lib>
                        <lib>${java.home}/jmods/java.management.rmi.jmod</lib>
                        <lib>${java.home}/jmods/java.rmi.jmod</lib>
                        <lib>${java.home}/jmods/java.desktop.jmod</lib>
                        <lib>${java.home}/jmods/java.logging.jmod</lib>
                        <lib>${java.home}/jmods/java.instrument.jmod</lib>
                        <lib>${java.home}/jmods/java.net.http.jmod</lib>
                        <lib>${java.home}/jmods/java.security.jgss.jmod</lib>
                        <lib>${java.home}/jmods/java.security.sasl.jmod</lib>
                        <lib>${java.home}/jmods/java.transaction.xa.jmod</lib>
                        <lib>${java.home}/jmods/java.datatransfer.jmod</lib>
                        <lib>${java.home}/jmods/java.prefs.jmod</lib>
                        <lib>${java.home}/jmods/java.compiler.jmod</lib>
                        <lib>${java.home}/jmods/java.scripting.jmod</lib>
                        <lib>${java.home}/jmods/jdk.unsupported.jmod</lib>
                        <lib>${java.home}/jmods/jdk.httpserver.jmod</lib>
                        <lib>${java.home}/jmods/jdk.crypto.ec.jmod</lib>
                    </libs>
                </configuration>
                <dependencies>
                    <!-- ProGuard 7.6.x: supports the Java 21 class-file format. -->
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>7.6.1</version>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- Writes META-INF/build-info.properties, so the server can say which
                         version it is: the mobile app shows it when connecting, and will
                         compare it to its own bundle to decide whether to update. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 1. Empties static/ so hashed bundles of an older build do not pile up. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-frontend-static</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <skip>${skipFrontend}</skip>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${frontend.static.dir}</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                </fileset>
                                <fileset>
                                    <directory>${frontend.mobile.dir}</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Builds the Angular app with a Node installed under ui/node, so the build
                 does not depend on the machine's own Node version. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>${frontend.dir}</workingDirectory>
                    <installDirectory>${frontend.dir}</installDirectory>
                    <nodeVersion>v22.22.0</nodeVersion>
                    <npmVersion>10.9.4</npmVersion>
                    <skip>${skipFrontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build-mobile</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build:mobile</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. Copies the build (index.html, *.js, *.css...) into static/, before
                 process-resources puts static/ on the classpath. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${skipFrontend}</skip>
                            <outputDirectory>${frontend.static.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${frontend.dir}/dist/ui/browser</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-frontend-mobile</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${skipFrontend}</skip>
                            <outputDirectory>${frontend.mobile.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${frontend.dir}/dist/ui-mobile/browser</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- =================================================================
             Native installer via jpackage, for Windows, macOS and Linux.

               mvn -Pinstaller verify

             jpackage can only build for the OS it runs on (no cross-build), so
             run it on each target. The os-* profiles below auto-select the
             right per-OS argfile from src/main/jpackage/. The installer bundles
             a jlink runtime + the ProGuard-obfuscated fat jar: a real JVM, so
             POI / the JDBC drivers / the in-process restart all work and the
             obfuscation is preserved. It is NOT GraalVM native-image.

             Writable state (H2 DB, license, downloads) is redirected to
             ${user.home}/.libertyshop by runtime.args, so the app runs even
             when installed read-only. Point ${java.home} at a GraalVM 21 JDK
             to embed a GraalVM runtime.

             Per-OS native-tool prerequisites on the BUILD machine:
               Windows exe/msi : WiX Toolset v3
               Linux   deb     : dpkg-deb + fakeroot   (rpm: rpmbuild)
               macOS   dmg/pkg : Xcode command line tools (+ signing to ship)
             ================================================================= -->
        <profile>
            <id>installer</id>
            <properties>
                <!-- jpackage rejects SNAPSHOT / a 0 major on Windows; keep it numeric. -->
                <installer.version>1.0.0</installer.version>
                <jpackage.input>${project.build.directory}/jpackage/input</jpackage.input>
                <jpackage.dest>${project.build.directory}/jpackage/dist</jpackage.dest>
                <jpackage.config>${project.basedir}/src/main/jpackage</jpackage.config>
                <!-- Overridden by the os-* profiles. Left blank so a bare run on an
                     unrecognised OS fails fast with a missing-argfile error. -->
                <installer.os></installer.os>
                <!-- PATH handed to jpackage. os-windows prepends the WiX folder so the
                     build does not depend on the PATH the IDE was started with. -->
                <jpackage.path>${env.PATH}</jpackage.path>
            </properties>
            <build>
                <plugins>
                    <!-- Stage ONLY the fat jar into a clean input dir: jpackage copies the
                         whole input dir into the app image, so target/ as-is would drag in
                         the proguard base jar, loose classes, etc. Bound to verify so the
                         repackaged (obfuscated) jar already exists. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-jpackage-input</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Run the JDK's own jpackage. OS-agnostic here: the installer type and
                         the platform GUI flags come from the per-OS @argfile, and the runtime
                         JVM options (incl. the ${user.home} path redirects) from runtime.args.
                         @argfiles are read raw by jpackage, so ${user.home} reaches the target
                         machine unresolved and Spring expands it there. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <environmentVariables>
                                        <PATH>${jpackage.path}</PATH>
                                    </environmentVariables>
                                    <arguments>
                                        <argument>--name</argument>
                                        <argument>Liberty Shop</argument>
                                        <argument>--app-version</argument>
                                        <argument>${installer.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>Houssen</argument>
                                        <argument>--description</argument>
                                        <argument>Liberty Shop - point de vente</argument>
                                        <argument>--input</argument>
                                        <argument>${jpackage.input}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>org.springframework.boot.loader.launch.JarLauncher</argument>
                                        <argument>--dest</argument>
                                        <argument>${jpackage.dest}</argument>
                                        <!-- jlink runtime: java.se pulls every Java SE module; the
                                             jdk.* extras cover Unsafe, EC/PKCS11 crypto (JWT +
                                             license signatures), zipfs, locales, management. -->
                                        <argument>--add-modules</argument>
                                        <argument>java.se,jdk.unsupported,jdk.crypto.ec,jdk.crypto.cryptoki,jdk.zipfs,jdk.httpserver,jdk.localedata,jdk.management,jdk.security.auth,jdk.net</argument>
                                        <!-- Shared JVM options + writable-path redirects. -->
                                        <argument>@${jpackage.config}/runtime.args</argument>
                                        <!-- Installer type + platform GUI flags (windows|mac|linux). -->
                                        <argument>@${jpackage.config}/${installer.os}.args</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Auto-selected by the build OS; each only picks the matching argfile.
             NB: macOS reports both "mac" and "unix"; os-mac is declared after
             os-linux so it wins there and installer.os resolves to "mac". -->
        <profile>
            <id>os-linux</id>
            <activation>
                <os><family>unix</family></os>
            </activation>
            <properties>
                <installer.os>linux</installer.os>
            </properties>
        </profile>
        <profile>
            <id>os-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <installer.os>mac</installer.os>
            </properties>
        </profile>
        <profile>
            <id>os-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <installer.os>windows</installer.os>
                <!-- WiX Toolset v3 binaries (candle.exe, light.exe). Override with
                     -Dwix.home=... if WiX lives elsewhere. -->
                <wix.home>${env.LOCALAPPDATA}\WiX Toolset v3.14</wix.home>
                <jpackage.path>${wix.home};${env.PATH}</jpackage.path>
            </properties>
        </profile>
    </profiles>

</project>

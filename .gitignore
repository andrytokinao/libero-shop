/.idea/
/ui/.vscode/

# H2 database written at runtime by spring.datasource.url
/backend/data/
/backend/target/

# Angular build copied in by the Maven build (see backend/pom.xml), and the Node it installs
/backend/src/main/resources/static/
/backend/src/main/resources/mobile-web/
/ui/node/
*.stackdump

# Local experiments and verification artefacts
/scratch/
/backend/${project.build.directory}/
/license/.license-state
/license/.license-trial
/data/libertyshop.mv.db

# Mobile app: the signing key and its passwords never enter the repository (see
# docs/mobile-android.md), nor do the APKs published beside the server.
*.jks
*.keystore
/ui/android/keystore.properties
/downloads/
/backend/downloads/
*.apk
*.aab

# Android project generated by Capacitor (ui/android/). Its own .gitignore says the
# same; repeated here so nothing slips in if that file is ever lost or regenerated.
# Copied in by `npx cap sync` from the Angular build and capacitor.config.ts:
/ui/android/app/src/main/assets/public/
/ui/android/app/src/main/assets/capacitor.config.json
/ui/android/app/src/main/assets/capacitor.plugins.json
/ui/android/app/src/main/res/xml/config.xml
/ui/android/capacitor-cordova-android-plugins/
# Build outputs, Gradle and Android Studio state:
/ui/android/.gradle/
/ui/android/build/
/ui/android/app/build/
/ui/android/app/release/
/ui/android/.idea/
/ui/android/.kotlin/
/ui/android/.cxx/
/ui/android/app/.cxx/
/ui/android/.externalNativeBuild/
/ui/android/captures/
*.iml
# The SDK path of one machine:
/ui/android/local.properties
/.gradle/
